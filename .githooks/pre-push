#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
if command -v gitleaks >/dev/null 2>&1; then
  scanner=$(command -v gitleaks)
elif [ -x .tools/gitleaks/gitleaks ]; then
  scanner=.tools/gitleaks/gitleaks
else
  printf '%s\n' 'Push blocked: install Gitleaks and rerun. See SECURITY.md.' >&2
  exit 1
fi
exec "$scanner" git --redact=100 --no-banner .
