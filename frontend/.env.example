# Network the dApp talks to. Defaults to Avalanche Fuji testnet.
NUXT_PUBLIC_CHAIN_ID=43113
NUXT_PUBLIC_CHAIN_NAME="Avalanche Fuji"
NUXT_PUBLIC_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NUXT_PUBLIC_EXPLORER_URL=https://testnet.snowtrace.io

# Leave both empty to run campaign funding in demo mode (no transactions are sent).
# Set them to a deployed CampaignEscrow and its ERC-20 to fund orders on-chain.
NUXT_PUBLIC_TOKEN_ADDRESS=
NUXT_PUBLIC_ESCROW_ADDRESS=
NUXT_PUBLIC_TOKEN_SYMBOL=USD₮
NUXT_PUBLIC_TOKEN_DECIMALS=6

# Public feature flag, not a secret. Vercel's landing build sets this automatically.
NUXT_PUBLIC_LANDING_ONLY=false
# Never put private keys, API credentials, database URLs or session secrets in NUXT_PUBLIC_*.
