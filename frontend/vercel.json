{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run generate:landing && bun run verify:landing",
  "outputDirectory": ".output/public",
  "cleanUrls": true,
  "redirects": [
    { "source": "/connect", "destination": "/#pilot", "permanent": false },
    { "source": "/dashboard", "destination": "/#pilot", "permanent": false },
    { "source": "/brands/:path*", "destination": "/#pilot", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
